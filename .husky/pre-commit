#!/bin/bash
# ─── Pre-commit hook ────────────────────────────────────────────────────────
# Runs lint-staged (tsc + eslint on staged JS/TS files), plus cargo check if
# Rust files changed, and frontend build sanity check.
# Merge commits (2+ parents) skip Rust/web checks automatically.

set -e

# Skip heavy checks for merge commits
if [ "$(git log -1 --format=%P | wc -w)" -gt 1 ]; then
  echo "⟦pre-commit⟧ Merge commit — skipping cargo/frontend checks"
  npx lint-staged
  exit 0
fi

echo "⟦pre-commit⟧ Running lint-staged..."
npx lint-staged

# Export PATH so cargo (from ~/.cargo/bin) is found inside git hooks
export PATH="$HOME/.cargo/bin:$PATH"

# Check if Rust files were modified
RUST_CHANGED=$(git diff --cached --name-only | grep -c '\.rs$' || true)
if [ "$RUST_CHANGED" -gt 0 ]; then
  echo "⟦pre-commit⟧ Rust files changed — running cargo check..."
  (cd server/spacetimedb && cargo check 2>&1)
  echo "⟦pre-commit⟧ Rust changed — running reducer-drift audit (static checks)..."
  (cd "$(git rev-parse --show-toplevel)" && python3 scripts/audit_reducer_drift.py 2>&1 | tail -8)
fi

# Check if any web/src files changed → quick type check
WEB_SRC_CHANGED=$(git diff --cached --name-only | grep -c '^web/src/' || true)
if [ "$WEB_SRC_CHANGED" -gt 0 ]; then
  echo "⟦pre-commit⟧ Frontend source changed — running TypeScript check..."
  (cd web && npx tsc --noEmit 2>&1)
fi

# Check if Python files changed → run API server tests
PYTHON_CHANGED=$(git diff --cached --name-only | grep -c '\.py$' || true)
if [ "$PYTHON_CHANGED" -gt 0 ]; then
  echo "⟦pre-commit⟧ Python files changed — running API server unit tests..."
  (cd server && python3 -m pytest tests/ --tb=short -q \
    --ignore=tests/test_page_metadata_and_settings.py \
    --ignore=tests/test_core_reducers.py \
    --ignore=tests/test_collection_permission_search.py \
    --ignore=tests/test_collection_permission_reducers.py \
    --ignore=tests/test_misc_reducers.py \
    --ignore=tests/test_mcp_live_stdb.py \
    --ignore=tests/test_api_live_stdb.py 2>&1 | tail -5)
  echo "⟦pre-commit⟧ Running MCP server unit tests..."
  (cd server/mcp-server && python3 -m pytest tests/ --tb=short -q 2>&1 | tail -3)
fi
