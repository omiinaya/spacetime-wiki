# ─── SpacetimeWiki — Docker Compose Environment ──────────────────────────────

# SpacetimeDB
STDB_HOST=spacetimedb:3001
STDB_DATABASE=spacetime_wiki

# Python API Server
API_PORT=8711
RATE_LIMIT=100/minute

# Frontend (Vite build args)
VITE_STDB_HOST=spacetimedb:3001
VITE_STDB_DB=spacetime_wiki
VITE_API_BASE=http://api-server:8711
