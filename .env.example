# ─── SpacetimeWiki — Environment Configuration ─────────────────────────────
#
# Copy this to .env and edit for your deployment:
#   cp .env.example .env
#
# All services read from environment. Docker Compose sources .env automatically.
# For local dev without Docker, set these in your shell or .env file.

# ═══════════════════════════════════════════════════════════════════════════════
# SpacetimeDB Server
# ═══════════════════════════════════════════════════════════════════════════════

# SpacetimeDB HTTP API address (used by API server, MCP server, module publisher)
# Format: host:port
STDB_HOST=spacetimedb:3001

# SpacetimeDB database name (must match what was used with `spacetime publish`)
# IMPORTANT: Use hyphens, not underscores — STDB 2.x rejects underscores in
# HTTP API URL paths. Both the publish command and this variable must agree.
STDB_DATABASE=spacetime-wiki

# ═══════════════════════════════════════════════════════════════════════════════
# FastAPI REST Gateway (server/api-server/)
# ═══════════════════════════════════════════════════════════════════════════════

# Port the FastAPI server listens on
API_PORT=8711

# Rate limiting for REST API (format: "<count>/<period>", e.g. "100/minute")
# Set to empty string or "0" to disable rate limiting
RATE_LIMIT=100/minute

# Set to "1" or "true" to enable uvicorn auto-reload on file changes
# (only useful in local development, not Docker Compose)
# RELOAD=1

# ═══════════════════════════════════════════════════════════════════════════════
# Module Publisher (server/spacetimedb/ — Docker Compose one-shot service)
# ═══════════════════════════════════════════════════════════════════════════════

# Database name to publish the module as (same as STDB_DATABASE)
DB_NAME=spacetime-wiki

# ═══════════════════════════════════════════════════════════════════════════════
# Frontend (web/ — React SPA via Vite)
#
# These are Vite build-time env vars. In Docker Compose they're passed as
# build args. For local dev with `npm run dev`, set them in web/.env or
# export them in your shell with the VITE_ prefix.
# ═══════════════════════════════════════════════════════════════════════════════

# SpacetimeDB WebSocket address for real-time subscriptions
# Must include host:port (ws:// prefix not needed)
VITE_STDB_HOST=spacetimedb:3001

# SpacetimeDB database name or hex ID
VITE_STDB_DB=spacetime-wiki

# Optional STDB auth token for secured deployments
# VITE_STDB_TOKEN=

# REST API base URL (Python FastAPI backend)
# In Docker Compose: http://api-server:8711
# For local dev: http://localhost:8711
VITE_API_BASE=http://api-server:8711

# Optional API key for REST API calls (set in web/src/lib/api/client.ts)
# If empty/unset, requests are sent without authentication
# VITE_API_KEY=swk_abc123...

# ═══════════════════════════════════════════════════════════════════════════════
# MCP Server (server/mcp-server/)
# ═══════════════════════════════════════════════════════════════════════════════

# Name the MCP server advertises (for Hermes Agent's native_mcp config)
MCP_SERVER_NAME=spacetime-wiki-mcp

# MCP server reads STDB_HOST and STDB_DATABASE from the same variables above

# ═══════════════════════════════════════════════════════════════════════════════
# Notes
# ═══════════════════════════════════════════════════════════════════════════════
#
# - The frontend (`VITE_*` vars) runs at build time in Docker, so changing
#   them requires a `docker compose build frontend` to take effect.
# - For local dev without Docker, you can set VITE_ vars in web/.env instead.
# - The STDB_HOST default (`spacetimedb:3001`) only works inside Docker
#   network. For local dev, set: STDB_HOST=localhost:3001
# - VITE_STDB_DB can be either the database name (string) or the full hex ID.
#   The TypeScript SDK accepts both forms.
