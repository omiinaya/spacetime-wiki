{
  "name": "spacetime-wiki",
  "version": "1.0.0",
  "description": "SpacetimeDB-powered knowledge wiki — Outline-inspired with feature parity",
  "private": true,
  "workspaces": ["web"],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "lint": "eslint . --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern target --ignore-pattern server/spacetimedb --ignore-pattern .git",
    "lint:fix": "eslint . --fix --ignore-pattern node_modules --ignore-pattern dist --ignore-pattern target --ignore-pattern server/spacetimedb --ignore-pattern .git",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,css,md}' --ignore-path .prettierignore",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json,css,md}' --ignore-path .prettierignore"
  },
  "lint-staged": {
    "web/src/**/*.{ts,tsx,js,jsx,json,css,md}": [
      "node node_modules/.bin/prettier --write",
      "bash -c 'cd web && node ../node_modules/.bin/vitest run --changed --reporter=verbose --no-color 2>&1'"
    ],
    "server/spacetimedb/src/**/*.rs": []
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omiinaya/spacetime-wiki.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/omiinaya/spacetime-wiki/issues"
  },
  "homepage": "https://github.com/omiinaya/spacetime-wiki#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.63.0",
    "eslint-config-prettier": "^10.1.8"
  },
  "type": "module"
}
