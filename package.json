{
  "name": "spacetime-wiki",
  "version": "1.0.0",
  "description": "SpacetimeDB-powered knowledge wiki — Outline-inspired with feature parity",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "lint": "cd web && npm run lint",
    "lint:fix": "cd web && npm run lint:fix",
    "format": "cd web && npm run format",
    "format:check": "cd web && npm run format:check"
  },
  "lint-staged": {
    "web/src/**/*.{ts,tsx,js,jsx,json,css,md}": [
      "node /home/hindsight/spacetime-wiki/web/node_modules/.bin/prettier --write",
      "bash -c 'cd web && node /home/hindsight/spacetime-wiki/web/node_modules/.bin/vitest run --changed --reporter=verbose --no-color 2>&1 | tail -5'"
    ],
    "server/spacetimedb/src/**/*.rs": []
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omiinaya/spacetime-wiki.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/omiinaya/spacetime-wiki/issues"
  },
  "homepage": "https://github.com/omiinaya/spacetime-wiki#readme",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  }
}
